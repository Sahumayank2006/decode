# ──────────────────────────────────────────────────
# DECODE – Environment Variables
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────────

# Flask
SECRET_KEY=change-this-in-production
DEBUG=true
PORT=5000

# Firebase / Firestore
# Option A: path to downloaded service account JSON
FIREBASE_CREDENTIALS_PATH=./config/firebase_credentials.json

# Option B: paste the entire JSON as a string (for CI/Docker)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

FIREBASE_PROJECT_ID=decode-app
FIREBASE_STORAGE_BUCKET=decode-app.appspot.com

# OCR
TESSERACT_CMD=tesseract
