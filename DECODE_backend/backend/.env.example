# ──────────────────────────────────────────────────
# DECODE – Environment Variables
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────────

# Flask
SECRET_KEY=change-this-in-production
DEBUG=true
PORT=5000

# Firebase / Firestore
# Option A: path to downloaded service account JSON
FIREBASE_CREDENTIALS_PATH=./config/firebase_credentials.json

# Option B: paste the entire JSON as a string (for CI/Docker)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

FIREBASE_PROJECT_ID=decode-app
FIREBASE_STORAGE_BUCKET=decode-app.appspot.com

# LLM – Chart Intelligence
# Just add your Gemini API key here and restart the server.
# The app automatically switches from rule-based fallback to real LLM.
# No other settings need to change.
GEMINI_API_KEY=

# Chart Detection
DETECTION_CONFIDENCE_THRESHOLD=0.55

# Compliance Scoring
COMPLIANCE_LOW_MAX=40
COMPLIANCE_MEDIUM_MAX=70
